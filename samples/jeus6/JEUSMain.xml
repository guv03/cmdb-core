        <class-ftp>true</class-ftp>
        <sequential-start>true</sequential-start>
        <enable-webadmin>false</enable-webadmin>
        <engine-container>
            <name>container1</name>
	    <command-option>
                -Xms1024m -Xmx2048m -XX:MaxPermSize=128m
            </command-option>
            <sequential-start>true</sequential-start>
            <engine-command>
                <type>servlet</type>
                <name>engine1</name>
            </engine-command>
	    <system-logging>
                <level>INFO</level>
                <handler>
                    <file-handler>
                        <name>fileHandler</name>
                        <valid-day>1</valid-day>
                        <buffer-size>0</buffer-size>
                    </file-handler>
                </handler>
            </system-logging>
        </engine-container>
